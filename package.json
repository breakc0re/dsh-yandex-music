{
  "name": "dsh-yandex-music",
  "version": "1.0.0",
  "description": "Яндекс.Музыка в боковой панели DSH: поиск, очередь, плейлисты, «Моя волна» и текст песни с караоке.",
  "type": "module",
  "main": "server.js",
  "exports": {
    ".": "./server.js",
    "./client": "./client.js"
  },
  "files": [
    "server.js",
    "lib/*.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "cordis",
    "yandex-music",
    "music",
    "player",
    "lyrics"
  ],
  "license": "MIT",
  "author": "breakc0re",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/breakc0re/dsh-yandex-music.git"
  },
  "homepage": "https://github.com/breakc0re/dsh-yandex-music#readme",
  "bugs": {
    "url": "https://github.com/breakc0re/dsh-yandex-music/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
