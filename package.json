{
  "name": "dsh-yandex-music",
  "version": "0.3.0",
  "private": true,
  "description": "Yandex Music player in the DSH sidebar footer",
  "type": "module",
  "main": "server.js",
  "exports": {
    ".": "./server.js",
    "./client": "./client.js"
  },
  "files": [
    "server.js",
    "lib/*.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
